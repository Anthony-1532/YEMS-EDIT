# YEMS Frontend Configuration
# Note: This frontend uses static HTML/JS without a bundler.
# Environment variables are applied via window.YEMS_CONFIG in js/config.js
#
# Local dev (no Docker): backend runs on :4000 — frontend js/config.js falls back to http://localhost:4000/api
# Docker / Caddy: app served at localhost:8080 — config.js uses relative /api (Caddy proxies to backend:8080)
#
# To override the API URL, set window.YEMS_API_BASE_URL before config.js loads:
#   <script>window.YEMS_API_BASE_URL = 'http://your-api:4000/api';</script>

# Legacy - not used (requires Vite build step)
# VITE_API_BASE_URL=http://localhost:4000/api
# VITE_APP_NAME=YEMS